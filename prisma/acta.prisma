model Acta {
  id           Int         @id @default(autoincrement())
  nombreActa   String
  fechaReunion DateTime
  estado       Estado      @default(ABIERTA)
  visibilidad  Visibilidad @default(VISIBLE)
  createdAt    DateTime    @default(now())
  Voto         Voto[]

  @@index([estado])
  @@index([visibilidad])
  @@index([fechaReunion])
}

model Voto {
  id           Int      @id @default(autoincrement())
  actaId       Int
  consejeroId  String
  posicion     Posicion
  comentario   String?
  fechaEmision DateTime @default(now())
  acta         Acta     @relation(fields: [actaId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [consejeroId], references: [id])

  @@index([actaId])
  @@index([consejeroId])
}

model Reunion {
  id               Int      @id @default(autoincrement())
  fecha            DateTime
  fechaNormalizada String
  link             String
  createdAt        DateTime @default(now())
}

enum Estado {
  ABIERTA
  CERRADA
}

enum Visibilidad {
  VISIBLE
  OCULTA
}

enum Posicion {
  ACUERDO
  DESACUERDO
  ACUERDO_PARCIAL
}
