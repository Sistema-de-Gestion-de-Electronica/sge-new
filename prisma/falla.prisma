model Falla {
    id Int @id @default(autoincrement())

    equipoId Int? // Puede ser nulo si no está inventariado
    equipo   Equipo? @relation(fields: [equipoId], references: [id], onDelete: Cascade)

    tipoFalla String // "PC" o "Instrumento"

    fallas            String[] // Solo para PC
    descripcionEquipo String? // Solo para Instrumento
    descripcionFalla  String
    condicion         String? // Solo para Instrumento

    fechaReporte DateTime @default(now())

    reportadoPorId String?
    reportadoPor   User?   @relation("FallasReportadas", fields: [reportadoPorId], references: [id])

    asignadoAId String?
    asignadoA   User?   @relation("FallasAsignadas", fields: [asignadoAId], references: [id])

    estado        String
    palabrasClave String?

    historial FallaHistorial[]

    @@index([fechaReporte(sort: Desc)])
}

model FallaHistorial {
    id Int @id @default(autoincrement())

    fallaId Int
    falla   Falla @relation(fields: [fallaId], references: [id], onDelete: Cascade)

    fallas            String[]
    descripcionEquipo String?
    descripcionFalla  String
    reportadoPorId    String?
    asignadoAId       String?
    estado            String

    fechaReporte      DateTime
    fechaCambioEstado DateTime @default(now())

    reportadoPor User? @relation("FallaHistorialReportadoPor", fields: [reportadoPorId], references: [id])
    asignadoA    User? @relation("FallaHistorialAsignadoA", fields: [asignadoAId], references: [id])

    @@index([fallaId, fechaCambioEstado(sort: Desc)])
}
