model InscripcionEspecial {
  id                  Int       @id @default(autoincrement())
  solicitanteId       String
  caso                String
  justificacion       String
  turnoAlternativa1   String?
  turnoAlternativa2   String?
  materias            Int[]
  materiasAdeudadas   Int[]
  estado              String
  respuesta           String?
  fueContactado       Boolean?
  vinoPresencialmente Boolean?
  fechaSolicitud      DateTime  @default(now())
  fechaRespuesta      DateTime?
  solicitante         User      @relation("inscripcionesEspeciales", fields: [solicitanteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "InscripcionEspecial_solicitante_fkey")
}
