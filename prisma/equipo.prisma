model Equipo {
  id                   Int             @id @default(autoincrement())
  inventarioId         String          @unique
  modelo               String?
  numeroSerie          String?
  observaciones        String?
  palabrasClave        String?
  imagen               String?
  tipoId               Int
  marcaId              Int
  sedeId               Int
  laboratorioId        Int
  armarioId            Int?
  estanteId            Int?
  estadoId             Int
  disponible           Boolean         @default(true)
  fechaCreacion        DateTime        @default(now())
  fechaModificacion    DateTime        @default(now()) @updatedAt
  usuarioCreadorId     String
  usuarioModificadorId String
  armario              Armario?        @relation(fields: [armarioId], references: [id], onDelete: Restrict)
  estado               EquipoEstado    @relation(fields: [estadoId], references: [id])
  estante              Estante?        @relation(fields: [estanteId], references: [id], onDelete: Restrict)
  laboratorio          Laboratorio     @relation(fields: [laboratorioId], references: [id])
  marca                EquipoMarca     @relation(fields: [marcaId], references: [id])
  sede                 Sede            @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  tipo                 EquipoTipo      @relation(fields: [tipoId], references: [id])
  fallaPc              Falla[]
  reservas             ReservaEquipo[]

  @@index([modelo])
  @@index([numeroSerie])
}

model EquipoMarca {
  id               Int      @id @default(autoincrement())
  nombre           String
  fechaCreacion    DateTime @default(now())
  usuarioCreadorId String
  equipos          Equipo[]

  @@index([nombre])
}

model EquipoTipo {
  id                              Int                               @id @default(autoincrement())
  nombre                          String
  imagen                          String?
  fechaCreacion                   DateTime                          @default(now())
  usuarioCreadorId                String
  equipos                         Equipo[]
  reservaLaboratorioAbiertoEquipo ReservaLaboratorioAbiertoEquipo[]
  reservaLaboratorioCerradoEquipo ReservaLaboratorioCerradoEquipo[]

  @@index([nombre])
}

model EquipoEstado {
  id               Int      @id @default(autoincrement())
  nombre           String
  fechaCreacion    DateTime @default(now())
  usuarioCreadorId String
  equipos          Equipo[]

  @@index([nombre])
}
