model User {
  id                        String                      @id @default(cuid())
  name                      String                      @unique
  email                     String                      @unique
  emailVerified             Boolean?
  image                     String                      @default("/default-avatar.svg")
  nombre                    String?
  apellido                  String?
  fechaNacimiento           DateTime?                   @db.Date
  direccion                 String?
  piso                      String?
  departamento              String?
  ciudad                    String?
  codigoPostal              String?
  telefonoCasa              String?
  telefonoCelular           String?
  telefonoLaboral           String?
  documentoNumero           String?
  legajo                    String?                     @unique(map: "usuario_legajo_asc_idx")
  gitlab                    String?
  penalizaciones            Int                         @default(0)
  esDocente                 Boolean                     @default(false)
  esTutor                   Boolean                     @default(false)
  fechaRegistro             DateTime                    @default(now())
  fechaUltimoAcceso         DateTime                    @default(now())
  fechaUltimaActualizacion  DateTime                    @default(now()) @updatedAt
  documentoTipoId           Int?
  provinciaIso              String?
  paisIso                   String?
  accounts                  Account[]
  cursosComoProfesor        Curso[]
  cursosComoAyudante        CursoAyudante[]
  fallasAsignadas           Falla[]                     @relation("FallasAsignadas")
  fallasReportadas          Falla[]                     @relation("FallasReportadas")
  fallasHistAsignadas       FallaHistorial[]            @relation("FallaHistorialAsignadoA")
  fallasHistReportadas      FallaHistorial[]            @relation("FallaHistorialReportadoPor")
  inscripcionesEspeciales   InscripcionEspecial[]       @relation("inscripcionesEspeciales")
  materiasDirector          Materia[]                   @relation("materiasDirector")
  MateriaJefeTp             MateriaJefeTp[]             @relation("materiasJefeTrabajoPractico")
  reservasAprobadas         Reserva[]                   @relation("reservasAprobadas")
  reservasRechazadas        Reserva[]                   @relation("reservasRechazadas")
  reservasRecibidas         Reserva[]                   @relation("reservasRecibidas")
  reservasRenovadas         Reserva[]                   @relation("reservasRenovadas")
  reservasSolicitadas       Reserva[]                   @relation("reservasSolicitadas")
  reservasComoTutor         Reserva[]                   @relation("reservaTutor")
  ReservaLaboratorioCerrado ReservaLaboratorioCerrado[] @relation("reservasLaboratorioCerrado")
  sessions                  Session[]
  tutor                     Tutor?
  documentoTipo             DocumentoTipo?              @relation(fields: [documentoTipoId], references: [id], onDelete: Restrict)
  pais                      Pais?                       @relation(fields: [paisIso], references: [iso], onDelete: Restrict)
  provincia                 Provincia?                  @relation(fields: [provinciaIso, paisIso], references: [iso, paisIso], onDelete: Restrict)
  usuarioRol                UsuarioRol[]
  Voto                      Voto[]

  @@index([name])
  @@index([apellido])
  @@index([email])
  @@index([legajo], map: "usuario_legajo_hash_idx", type: Hash)
}

model Tutor {
  userId           String   @id @unique
  diasHorarios     String
  activo           Boolean
  especialidad     String
  fechaCreacion    DateTime @default(now())
  usuarioCreadorId String
  usuario          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([especialidad])
}

model UsuarioRol {
  userId           String
  rolId            Int
  fechaCreacion    DateTime @default(now())
  usuarioCreadorId String
  rol              Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  usuario          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, rolId])
}

model Rol {
  id                   Int          @id @default(autoincrement())
  nombre               String       @unique
  fechaCreacion        DateTime     @default(now())
  fechaModificacion    DateTime     @default(now()) @updatedAt
  usuarioCreadorId     String
  usuarioModificadorId String
  rolPermiso           RolPermiso[]
  usuarios             UsuarioRol[]

  @@index([nombre])
}

model RolPermiso {
  rolId            Int
  permisoId        Int
  fechaCreacion    DateTime @default(now())
  usuarioCreadorId String
  permiso          Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  rol              Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model Permiso {
  id                   Int          @id @default(autoincrement())
  sgeNombre            SgeNombre    @unique
  nombre               String
  rubro                String
  incluido             Boolean      @default(true)
  fechaCreacion        DateTime     @default(now())
  fechaModificacion    DateTime     @default(now()) @updatedAt
  usuarioCreadorId     String
  usuarioModificadorId String
  rolPermiso           RolPermiso[]

  @@unique([nombre, rubro])
  @@index([nombre])
  @@index([sgeNombre])
}

model Provincia {
  iso      String
  nombre   String
  paisIso  String
  pais     Pais   @relation(fields: [paisIso], references: [iso], onDelete: Cascade)
  usuarios User[]

  @@id([iso, paisIso])
  @@index([nombre])
}

model Pais {
  iso            String      @id
  nombreEspanol  String
  nombreIngles   String
  iso3           String
  codigoNumerico Int
  provincias     Provincia[]
  usuarios       User[]

  @@index([nombreEspanol])
  @@index([iso3])
  @@index([codigoNumerico])
}

model DocumentoTipo {
  id       Int    @id @default(autoincrement())
  nombre   String
  usuarios User[]
}
