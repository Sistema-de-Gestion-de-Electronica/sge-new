model Falla {
  id                Int              @id @default(autoincrement())
  equipoId          Int?
  tipoFalla         String
  fallas            String[]         @default([])
  descripcionEquipo String?
  descripcionFalla  String
  condicion         String?
  fechaReporte      DateTime         @default(now()) @db.Timestamp(6)
  reportadoPorId    String?
  asignadoAId       String?
  estado            String
  palabrasClave     String?
  asignadoA         User?            @relation("FallasAsignadas", fields: [asignadoAId], references: [id], onDelete: Cascade)
  equipo            Equipo?          @relation(fields: [equipoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reportadoPor      User?            @relation("FallasReportadas", fields: [reportadoPorId], references: [id], onDelete: Cascade)
  historial         FallaHistorial[]
}

model FallaHistorial {
  id                Int      @id @default(autoincrement())
  fallaId           Int
  fallas            String[]
  descripcionEquipo String?
  descripcionFalla  String
  reportadoPorId    String?
  asignadoAId       String?
  estado            String
  fechaReporte      DateTime @db.Timestamp(6)
  fechaCambioEstado DateTime @default(now()) @db.Timestamp(6)
  asignadoA         User?    @relation("FallaHistorialAsignadoA", fields: [asignadoAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  falla             Falla    @relation(fields: [fallaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reportadoPor      User?    @relation("FallaHistorialReportadoPor", fields: [reportadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fallaId, fechaCambioEstado(sort: Desc)])
}
