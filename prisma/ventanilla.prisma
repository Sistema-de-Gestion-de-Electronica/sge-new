model Consulta {
    id Int @unique @default(autoincrement())

    nombre         String
    apellido       String
    legajo         String?
    email          String
    asunto         String
    consulta       String
    fechaConsulta  DateTime  @default(now())
    respuesta      String?
    fechaRespuesta DateTime?
    estado         String    @default("Pendiente")
}
